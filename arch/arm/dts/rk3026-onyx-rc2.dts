/*
 * ONYX BOOX Robinson Crusoe 2 (MC_Kepler_R2, pcb V1.73), RK3026, 512 MiB DDR3.
 * U-Boot copy of the RC2 kernel DTS (rk3026-onyx-rc2.dts, Mario's v7.1.13
 * tree with our patches), adapted to this tree's rk3026.dtsi.
 *
 * Storage rule: the eMMC (0x1021c000), the NAND controller (0x10500000,
 * whose pads are the eMMC data lines on this board) and SDIO are deleted,
 * so the microSD slot is the only block device U-Boot can see.
 * Power rule: no PMIC is described (i2c buses stay disabled); the
 * regulators are not described either (no regulator driver is built).
 */

/dts-v1/;
#include "rk3026.dtsi"
#include <dt-bindings/input/input.h>

/delete-node/ &emmc;
/delete-node/ &nfc;
/delete-node/ &sdio;

/ {
	model = "Onyx Boox Robinson Crusoe 2";
	compatible = "onyx,rc2", "rockchip,rk3026";

	aliases {
		mmc0 = &sdmmc;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x20000000>; /* 512 MiB */
	};

	/*
	 * Top 1 MiB as in the kernel DTS: waveform, ramoops, loader log (stage2
	 * log 0x7fff0000, A/B flag 0x7fff3000, previous log 0x7fff4000, U-Boot
	 * bootcount and requests 0x7fff6000). U-Boot also caps its own RAM top
	 * at 0x7ff00000 (board_get_usable_ram_top).
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		waveform@7ff00000 {
			reg = <0x7ff00000 0x40000>;
			no-map;
		};

		ramoops@7ff40000 {
			compatible = "ramoops";
			reg = <0x7ff40000 0x80000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
		};

		loader-log@7ffc0000 {
			reg = <0x7ffc0000 0x40000>;
			no-map;
		};
	};

	/* described for completeness; no GPIO/button driver is built */
	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power";
			gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
		};

		key-pageup {
			label = "Page Up";
			gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEUP>;
		};

		key-pagedown {
			label = "Page Down";
			gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PAGEDOWN>;
		};

		key-back {
			label = "Back";
			gpios = <&gpio2 RK_PC3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_BACK>;
		};
	};

	/* the board code drives GPIO2_B7 directly (onyx-rc2.c) */
	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "status";
			gpios = <&gpio2 RK_PB7 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gpio1 {
	/* power hold: stage2 drives it high, board_early_init_f again */
	power-hold-hog {
		gpio-hog;
		gpios = <RK_PA2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "power_hold";
	};
};

&pinctrl {
	sdmmc {
		/* on eMMC boards the card detect is GPIO2_A3, not GPIO1_C1 */
		sdmmc_cd_gpio: sdmmc-cd-gpio {
			rockchip,pins = <2 RK_PA3 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <25000000>;
	cd-gpios = <&gpio2 RK_PA3 GPIO_ACTIVE_LOW>;
	disable-wp;
	fifo-mode;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_bus4 &sdmmc_cd_gpio>;
	status = "okay";
};

/*
 * UART2 sits on GPIO2_C6/C7, the EBC border pins on this board, with no
 * connector: the block is enabled as the "serial" console device but its
 * pins are never muxed. The console is the USB CDC-ACM gadget.
 */
&uart2 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

&usbphy {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&wdt {
	status = "okay";
};
